#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/ommega
RESTART_FILE=$STATE_DIR/restart.keymint
PEER_RESTART_FILE=$STATE_DIR/restart.injector
RESTART_ALL_FILE=$STATE_DIR/restart.all
CONF_PATH=${OMMEGA_CONF_PATH:-/data/misc/keystore/ommega/config}
LOG_DIR=/data/misc/keystore/ommega/logs
LOG_FILE=$LOG_DIR/daemon.log

# 本脚本的日志只落文件（见下面 log 的定义），「启用调试日志」关着时一条都不打。
# 开关按 2 秒一次的循环现读。
conf_get() {
  [ -f "$CONF_PATH" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*\(.*\)$/\1/p" "$CONF_PATH" 2>/dev/null | head -n1
}

debug_logging_enabled() {
  case "$(conf_get debug_logging | tr 'A-Z' 'a-z' | tr -d ' \r')" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# 日志只落文件：以前这里是 echo，输出会进管理器的 service 日志（那也是系统日志），
# 现在跟 daemon / payload 统一写到一个文件里。「启用调试日志」关着时一条都不打，
# 开关按 2 秒一次的循环现读。
log() {
  [ "$LOG_ON" = "1" ] || return 0
  mkdir -p "$LOG_DIR" 2>/dev/null
  printf '%s [INFO] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null
  return 0
}

# Extra library search paths are only needed on older Android. From Android 16
# (SDK 36) the default linker namespace already covers vendor/system/apex
# bionic, and overriding LD_LIBRARY_PATH here makes the linker resolve a
# libc++.so without `hash_memory`, so even sleep/chmod fail with
# "CANNOT LINK ... cannot locate symbol _ZNSt3__113hash_memoryEPKVm".
# keymint links fine with the defaults, so skip the override on SDK >= 36.
_SDK=$(getprop ro.build.version.sdk 2>/dev/null)
if [ -z "$_SDK" ] || [ "$_SDK" -lt 36 ]; then
  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/vendor/lib64/:/system/lib64/:/apex/com.android.runtime/lib64/bionic/"
fi
unset _SDK

# Resolve the device ABI.  One module zip now carries every ABI at once, so
# libs/<abi> has to be picked by what this device actually runs; falling back
# to directory order would hand an x86_64 device the arm64 binary.
device_abi() {
  local abi
  abi="$(getprop ro.product.cpu.abi 2>/dev/null)"
  [ -n "$abi" ] || abi="$(uname -m 2>/dev/null)"
  case "$abi" in
    arm64*|aarch64*) echo arm64-v8a ;;
    armeabi*|armv7*) echo armeabi-v7a ;;
    x86_64*) echo x86_64 ;;
    i?86|x86) echo x86 ;;
    *) echo "" ;;
  esac
}

find_module_keymint() {
  if [ -f "/data/adb/ommega/keymint" ]; then
    echo /data/adb/ommega/keymint
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi

  local abi
  abi=$(device_abi)
  if [ -n "$abi" ] && [ -f "$MODDIR/libs/$abi/keymint" ]; then
    echo "$MODDIR/libs/$abi/keymint"
    return 0
  fi

  # getprop/uname unavailable; accept any packaged ABI rather than nothing.
  for abi in arm64-v8a armeabi-v7a x86_64 x86; do
    if [ -f "$MODDIR/libs/$abi/keymint" ]; then
      echo "$MODDIR/libs/$abi/keymint"
      return 0
    fi
  done
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

# 单实例：同一个守护脚本只允许一份活。service.sh 那层看门循环有可能同时存在多份
# （管理器把 service.sh 拉起多次、或旧循环没清干净），每份都会 fork 一个本脚本，
# 而本脚本每轮开头都会 `pkill -9 -f <keymint 路径>` —— 多份并存时彼此把对方的
# shadow 反复 SIGKILL（daemon.log 里一串 exited with code 137）。抢不到锁的直接退。
LOCK_DIR=$STATE_DIR/keymint-daemon.lock

# 锁里的 pid 可能是上一个实例留下的，而那个 pid 号早被别的进程复用了 —— 只看 kill -0
# 会一直以为「还有人在跑」，守护就永久起不来（2026-10-16 在 NX721J / OPD2409 上都踩到：
# 锁里留着 1666，重启后那个号被内核线程占了，keymint 静默 exit 0，看门循环空转）。
# 所以除了「还活着」，还要确认这个 pid 现在跑的确实是本脚本。
holder_is_us() {
  p=$1
  s=$2
  [ -n "$p" ] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  [ -r "/proc/$p/cmdline" ] || return 1
  # cmdline 里的 NUL 转成空格，所以脚本路径后面一定跟着空格，正好把 daemon 和
  # daemon-injector 这种前缀相同的名字区分开。
  tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -F "sh $s " >/dev/null 2>&1
}

# 只认自己持有的锁：抢锁有竞态（两个实例同时认定「这是陈锁」时，先清后建的那份会把
# 对方刚建的锁删掉，结果两份都在跑、互相 pkill），所以拿到之后要再核一次归属，
# 退出时也只删自己的，别把下一任持有者的锁带走。
lock_owned() { [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$$" ]; }
release_lock() { lock_owned && rm -rf "$LOCK_DIR" 2>/dev/null; return 0; }

acquire_singleton() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    :
  else
    holder=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if holder_is_us "$holder" "$0"; then
      log "[keymint-daemon] another instance (pid $holder) is running; exiting"
      exit 0
    fi
    rm -rf "$LOCK_DIR" 2>/dev/null
    mkdir "$LOCK_DIR" 2>/dev/null || exit 0
  fi
  echo $$ > "$LOCK_DIR/pid"
  # 抢锁竞态兜底：再核一次，确实归自己才往下跑。
  sleep 1
  lock_owned || exit 0
  trap 'release_lock' EXIT INT TERM HUP
}
acquire_singleton

LOG_ON=0

while true; do
  LOG_ON=0
  debug_logging_enabled && LOG_ON=1

  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    log "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  # Clear a stale keymint instance (exact binary path) before starting a
  # fresh one, so a leftover child from a previous daemon run can never
  # coexist with the new instance. No other module process is matched.
  pkill -9 -f "$TARGET" 2>/dev/null
  sleep 1

  "$TARGET" "$@" &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      log "[keymint-daemon] restart requested"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  log "[keymint-daemon] keymint exited with code $rc"
  sleep 2
done
